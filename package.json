{
  "name": "publish-list",
  "version": "3.0.0",
  "description": "퍼블리싱 목록 — Next.js + React",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:next && npm run generate:registry && node scripts/dev/dev.mjs",
    "build:styles": "node scripts/build/build-styles.mjs",
    "build": "npm run prepare:next && npm run generate:registry && node scripts/build/build-styles.mjs && node scripts/build/build-next.mjs",
    "start": "node scripts/serve/serve-static.mjs",
    "start:http": "npx --yes serve@14 out -l 8090",
    "lint": "eslint src scripts *.mjs next.config.ts --max-warnings=0",
    "generate:registry": "node scripts/generate/registry.mjs && node scripts/generate/validate-project.mjs",
    "clean": "node scripts/build/clean.mjs",
    "clean:modules": "node scripts/build/clean.mjs --modules",
    "clean:all": "npm run clean && npm run clean:modules",
    "typecheck": "tsc --noEmit",
    "prepare:next": "node scripts/build/prepare-next.mjs",
    "postinstall": "npm run prepare:next",
    "test:watch": "node --test tests/watch.test.mjs",
    "test:watch:browser": "node --test tests/dev-watch.integration.mjs",
    "project:sync": "node scripts/generate/project.mjs sync",
    "validate:project": "node scripts/generate/validate-project.mjs",
    "test:project": "node --test tests/project.test.mjs tests/project-pages.test.mjs",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.11.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "ajv": "^8.17.1",
    "aos": "^2.3.4",
    "clipboard-copy": "^4.0.1",
    "dayjs": "^1.11.13",
    "detecctio": "^1.0.0",
    "filesize": "^10.1.6",
    "gsap": "^3.12.7",
    "hls.js": "^1.5.20",
    "js-base64": "^3.7.7",
    "lodash-es": "^4.17.21",
    "lottie-react": "^2.4.1",
    "lottie-web": "^5.12.2",
    "next": "^16.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-youtube": "^10.1.0",
    "simplebar-react": "^3.3.0",
    "swiper": "^12.2.0",
    "viewerjs": "^1.11.7",
    "webstomp-client": "^1.2.6",
    "xss": "^1.0.15",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/aos": "^3.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "raw-loader": "^4.0.2",
    "sass": "^1.83.0",
    "sass-embedded": "^1.108.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "and_chr >= 111"
  ],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  }
}
