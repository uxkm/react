# Supabase (프론트 — publishable key 또는 legacy anon key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# DB 마이그레이션 (pnpm db:migrate — git 제외, .env.production.local)
# Dashboard → Settings → Database → Connection string (URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# legacy 사용 시: VITE_SUPABASE_ANON_KEY=eyJ...

# Edge Function: Supabase 연동 시 production 빌드에서 기본 사용 (비활성화: false)
# VITE_COMMENTS_USE_EDGE_FUNCTION=true

# Cloudflare Turnstile (Supabase 연동 + Edge Function 사용 시 권장)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Edge Function 시크릿 (supabase secrets set)
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# IP_HASH_SALT=random-salt-string
# COMMENT_NOTIFY_PROVIDER=kakao
# KAKAO_NOTIFY_ENDPOINT_URL=https://your-kakao-gateway.example/send
# KAKAO_NOTIFY_ENDPOINT_TOKEN=optional-bearer-token
# KAKAO_SENDER_KEY=your-kakao-sender-key
# KAKAO_TEMPLATE_CODE=your-template-code
# COMMENT_NOTIFY_ENDPOINT_URL=https://your-notify-gateway.example/send
# COMMENT_NOTIFY_ENDPOINT_TOKEN=optional-bearer-token
# COMMENT_NOTIFY_RECIPIENTS=01011112222,01033334444

# 배포 도메인 (og:url 등)
# VITE_SITE_ORIGIN=https://doc.uxkm.io

# 로컬·배포 빌드: Supabase 미연동 시에만 localStorage 댓글 사용
# Supabase URL/키가 있으면 dev storage 설정과 무관하게 서버 댓글이 우선됩니다.
VITE_COMMENTS_DEV_STORAGE=false

# 로컬 관리자 페이지 비밀번호 (기본: uxkm-admin)
VITE_COMMENTS_DEV_ADMIN_PASSWORD=uxkm-admin
