# doc.uxkm.io — Supabase 공용 댓글
# cp env.production.local.example .env.production.local 후 Project URL 입력 → pnpm build
#
# Project URL: Supabase → Settings → API → Project URL
# Publishable key: Settings → API Keys → Publishable key

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# (선택) 댓글 등록 카카오톡(알림톡) 전송용 Edge Function 시크릿
# Supabase CLI:
# supabase secrets set COMMENT_NOTIFY_PROVIDER=kakao
# supabase secrets set KAKAO_NOTIFY_ENDPOINT_URL=https://your-kakao-gateway.example/send
# supabase secrets set KAKAO_NOTIFY_ENDPOINT_TOKEN=your-token
# supabase secrets set KAKAO_SENDER_KEY=your-sender-key
# supabase secrets set KAKAO_TEMPLATE_CODE=your-template-code
# supabase secrets set COMMENT_NOTIFY_RECIPIENTS=01011112222,01033334444
